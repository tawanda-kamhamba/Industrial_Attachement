<mxfile host="app.diagrams.net" modified="2026-06-02T00:00:00.000Z" agent="IAMS" version="22.1.0" type="device">
  <diagram id="deployment" name="Figure 4.1 Deployment">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Figure 4.1 — IAMS deployment layout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Three-tier web application (React + PHP + MySQL)&lt;/font&gt;" style="text;html=1;align=center;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="12" width="540" height="40" as="geometry" />
        </mxCell>

        <!-- Client tier -->
        <mxCell id="tierClient" value="Client tier" style="swimlane;startSize=24;fillColor=#E3F2FD;strokeColor=#1976D2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="100" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;Chrome / Edge / Firefox&lt;br&gt;Desktop &amp;amp; mobile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=10;" vertex="1" parent="tierClient">
          <mxGeometry x="20" y="36" width="160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;• Student&lt;br&gt;• Institutional supervisor&lt;br&gt;• Administrator&lt;br&gt;• Company supervisor (grade form)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="tierClient">
          <mxGeometry x="220" y="32" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="url" value="&lt;b&gt;URL (local)&lt;/b&gt;&lt;br&gt;http://localhost/iasms/app/&lt;br&gt;&lt;br&gt;&lt;b&gt;URL (hosted)&lt;/b&gt;&lt;br&gt;https://[your-domain]/iasms/app/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="tierClient">
          <mxGeometry x="480" y="32" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Presentation tier -->
        <mxCell id="tierPres" value="Presentation tier" style="swimlane;startSize=24;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="1020" height="120" as="geometry" />
        </mxCell>
        <mxCell id="react" value="&lt;b&gt;React SPA&lt;/b&gt;&lt;br&gt;TypeScript + Vite + Tailwind&lt;br&gt;Built to folder: &lt;b&gt;/iasms/app/&lt;/b&gt;&lt;br&gt;Routes: /login, /student, /supervisor, /admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6BC0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="tierPres">
          <mxGeometry x="20" y="36" width="280" height="72" as="geometry" />
        </mxCell>
        <mxCell id="apache" value="&lt;b&gt;Apache web server&lt;/b&gt;&lt;br&gt;XAMPP (development)&lt;br&gt;InfinityFree (production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6BC0;fontSize=10;" vertex="1" parent="tierPres">
          <mxGeometry x="340" y="44" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="static" value="Static assets&lt;br&gt;JS, CSS, images&lt;br&gt;(header_log.png, etc.)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=9;" vertex="1" parent="tierPres">
          <mxGeometry x="580" y="44" width="140" height="56" as="geometry" />
        </mxCell>

        <!-- Application tier -->
        <mxCell id="tierApp" value="Application tier" style="swimlane;startSize=24;fillColor=#FFF3E0;strokeColor=#EF6C00;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="phpapi" value="&lt;b&gt;PHP REST API&lt;/b&gt;&lt;br&gt;Entry: &lt;b&gt;/iasms/api/index.php&lt;/b&gt;&lt;br&gt;JSON over HTTP (GET/POST)&lt;br&gt;PHP sessions (student, supervisor, admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF6C00;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="tierApp">
          <mxGeometry x="20" y="36" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="modules" value="&lt;b&gt;API modules (examples)&lt;/b&gt;&lt;br&gt;auth_login.php&lt;br&gt;student_elogbook.php, student_report.php&lt;br&gt;supervisor_visit_schedule.php&lt;br&gt;admin_charts.php, admin_stats.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF6C00;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="tierApp">
          <mxGeometry x="300" y="36" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="helpers" value="Shared helpers&lt;br&gt;visit_schedule_helpers.php&lt;br&gt;notification_helpers.php&lt;br&gt;grading_helpers.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="tierApp">
          <mxGeometry x="560" y="36" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Data tier -->
        <mxCell id="tierData" value="Data tier" style="swimlane;startSize=24;fillColor=#E8F5E9;strokeColor=#43A047;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="&lt;b&gt;MySQL database&lt;/b&gt;&lt;br&gt;Database name: &lt;b&gt;IASMS&lt;/b&gt;&lt;br&gt;Tables: registered_students,&lt;br&gt;industrial_registration, elogbook_entries,&lt;br&gt;student_reports, visit schedule, grades, …" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="tierData">
          <mxGeometry x="20" y="32" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="Schema file:&lt;br&gt;iasms.sql&lt;br&gt;(phpMyAdmin import)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=9;" vertex="1" parent="tierData">
          <mxGeometry x="360" y="44" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="conn" value="database_connection.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=9;" vertex="1" parent="tierData">
          <mxGeometry x="520" y="44" width="160" height="56" as="geometry" />
        </mxCell>

        <!-- File storage -->
        <mxCell id="tierFiles" value="File storage (server disk)" style="swimlane;startSize=24;fillColor=#FCE4EC;strokeColor=#C2185B;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="470" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="reports" value="&lt;b&gt;Final reports&lt;/b&gt;&lt;br&gt;submit_report/uploads/&lt;br&gt;PDF, DOC, DOCX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="tierFiles">
          <mxGeometry x="12" y="32" width="120" height="76" as="geometry" />
        </mxCell>
        <mxCell id="contracts" value="&lt;b&gt;Contracts&lt;/b&gt;&lt;br&gt;student_contracts&lt;br&gt;(PDF in DB / uploads)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="tierFiles">
          <mxGeometry x="144" y="32" width="120" height="76" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" value="HTTPS / HTTP" style="endArrow=block;html=1;strokeWidth=2;endFill=1;fontSize=9;" edge="1" parent="1" source="browser" target="react">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="fetch /api/… JSON" style="endArrow=block;html=1;strokeWidth=2;endFill=1;fontSize=9;dashed=0;" edge="1" parent="1" source="react" target="phpapi">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="300" as="sourcePoint" />
            <mxPoint x="200" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="SQL queries" style="endArrow=block;html=1;strokeWidth=2;endFill=1;fontSize=9;" edge="1" parent="1" source="phpapi" target="mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="read / write files" style="endArrow=block;html=1;strokeWidth=1;endFill=1;fontSize=9;dashed=1;" edge="1" parent="1" source="phpapi" target="reports">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=1;endFill=1;dashed=1;" edge="1" parent="1" source="phpapi" target="contracts">
          <mxGeometry relative="1" as="geometry" />
