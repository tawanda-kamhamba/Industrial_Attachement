        <mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt; Solid arrows = main request/data flow. Dashed = file I/O or static hosting." style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=9;" vertex="1" parent="1">
